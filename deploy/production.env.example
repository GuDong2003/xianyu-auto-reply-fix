XIANYU_IMAGE=ghcr.io/owner/repository@sha256:REPLACE_WITH_64_HEX_IMAGE_DIGEST
XIANYU_GHCR_REPOSITORY=ghcr.io/owner/repository
XIANYU_EXPECTED_EGRESS_IP=
XIANYU_SHADOW_MODE=true
XIANYU_LOCAL_VERIFICATION_HANDOFF_ENABLED=false
XIANYU_LOCAL_VERIFICATION_PUBLIC_ORIGIN=
XIANYU_REMOTE_VERIFICATION_ENABLED=false
XIANYU_REMOTE_VERIFICATION_PUBLIC_ORIGIN=
XIANYU_CONTROL_PORT=9000
XIANYU_LEGACY_CONTAINER=xianyu-auto-reply-fix

XIANYU_DATA_DIR=/opt/xianyu-auto-reply-fix/data
XIANYU_PROFILES_DIR=/opt/xianyu-production/accounts
XIANYU_LOGS_DIR=/opt/xianyu-auto-reply-fix/logs
XIANYU_BACKUPS_DIR=/opt/xianyu-auto-reply-fix/backups
XIANYU_UPLOADS_DIR=/opt/xianyu-production/uploads
XIANYU_TRAJECTORY_DIR=/opt/xianyu-production/trajectory_history
XIANYU_CONFIG_FILE=/opt/xianyu-auto-reply-fix/global_config.yml

XIANYU_MASTER_KEY_FILE=/opt/xianyu-production/secrets/xianyu_master_key
XIANYU_CONNECTOR_TOKEN_FILE=/opt/xianyu-production/secrets/connector_internal_token
XIANYU_LEGACY_SECRET_FILE=/opt/xianyu-production/secrets/legacy_secret_key
XIANYU_ADMIN_PASSWORD_FILE=/opt/xianyu-production/secrets/admin_password
XIANYU_JWT_SECRET_FILE=/opt/xianyu-production/secrets/jwt_secret

COMPOSE_FILE=/opt/xianyu-production/staging/compose.production.yml
ENV_FILE=/opt/xianyu-production/production.env
RELEASE_ROOT=/opt/xianyu/releases
RELEASE_TARGET=control

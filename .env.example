# Xianyu Admin Docker Compose configuration example
#
# Copy this file to .env for local Docker Compose overrides:
#
#   cp .env.example .env
#
# .env is ignored by Git. Do not commit real passwords, Cookie values, API keys,
# tokens, or database files.

# Runtime
TZ=Asia/Shanghai
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
LOG_LEVEL=INFO
DEBUG=false
RELOAD=false

# Initial administrator account
# If ADMIN_PASSWORD is set before the first database initialization, the default
# admin user will be created with this password. Existing databases keep their
# current password and should be changed in the Web UI.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-first-run
JWT_SECRET_KEY=change-me-to-a-long-random-secret
SESSION_TIMEOUT=3600

# Database and logging
DB_PATH=/app/data/xianyu_data.db
SQL_LOG_ENABLED=true
SQL_LOG_LEVEL=INFO

# Sensitive field encryption
# Leave blank to let the application generate and persist a key under data/.
# Set a stable Fernet key only if you know you need to manage it externally.
SECRET_ENCRYPTION_KEY=

# Multi-user features
MULTIUSER_ENABLED=true
USER_REGISTRATION_ENABLED=true
EMAIL_VERIFICATION_ENABLED=true
CAPTCHA_ENABLED=true
TOKEN_EXPIRE_TIME=86400

# Automation features
AUTO_REPLY_ENABLED=true
AUTO_DELIVERY_ENABLED=true
AUTO_DELIVERY_TIMEOUT=30
API_CARD_TIMEOUT=10
BATCH_DATA_LOCK_TIMEOUT=5

# AI reply
AI_REPLY_ENABLED=false
DEFAULT_AI_MODEL=qwen-plus
DEFAULT_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Configure provider API keys in the Web UI or local-only environment files.
AI_REQUEST_TIMEOUT=30
AI_MAX_TOKENS=100

# Xianyu websocket and token refresh
WEBSOCKET_URL=wss://wss-goofish.dingtalk.com/
HEARTBEAT_INTERVAL=15
HEARTBEAT_TIMEOUT=5
TOKEN_REFRESH_INTERVAL=3600
TOKEN_RETRY_INTERVAL=300
MESSAGE_EXPIRE_TIME=300000

# Docker build mirrors for docker-compose-cn.yml
BASE_IMAGE=docker.m.daocloud.io/library/python:3.11-slim-bookworm
PLAYWRIGHT_DOWNLOAD_HOST=https://npmmirror.com/mirrors/playwright

# Optional build/runtime proxies
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Docker resource limits
MEMORY_LIMIT=2048
CPU_LIMIT=2.0
MEMORY_RESERVATION=512
CPU_RESERVATION=0.5
